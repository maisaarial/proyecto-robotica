<?xml version="1.0"?>
<launch>
  <include file="$(find launcher_robots_lab_robotica)/launch/robot_204.launch"/>
  <node name="gesture_action_server" pkg="gestos_robot_pkg" type="gesture_action_server.py"/>
  
  <node name="cam_tablero" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/video0"/>
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="usb_cam" />
  </node>
  <node name="cam_gestos" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/video0"/>
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="usb_cam" />
  </node>
</launch>

